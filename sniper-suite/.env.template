# Copy to `.env` and fill in. NEVER commit the real `.env` (it is gitignored).
# Everything here feeds docker-compose.yml; the bot itself reads config.toml
# plus the secret env vars listed at the bottom.

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=sniper
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sniper

# ---- Bot runtime -------------------------------------------------------------
# Log level for the bot container (trace|debug|info|warn|error).
RUST_LOG=info

# Control-API bind on the HOST. Keep 127.0.0.1 unless a TLS reverse proxy
# sits in front; the server itself refuses non-loopback binds without API
# auth keys configured.
API_BIND_HOST=127.0.0.1
API_PORT=8080

# Host path of the Solana keypair JSON, mounted read-only into the container
# at /run/secrets/solana_keypair.json.
SOLANA_KEYPAIR_HOST_PATH=./keys/solana.json

# ---- Secret env vars read directly by the bot process ------------------------
# (set these in your shell / secrets manager when running WITHOUT compose;
#  with compose, add them under `environment:` in docker-compose.yml from a
#  secure source — do not paste secrets into this template's committed copy.)
#
# SOLANA_KEYPAIR=/run/secrets/solana_keypair.json   # already set by compose
# SIGNING_PROVIDER=local                            # local|vault|kms|hsm (only local implemented;
#                                                   # others fail startup — no silent fallback)
# TREASURY_KEYPAIR=/run/secrets/treasury.json       # per-identity keypair spec, referenced by
#                                                   # [[signing.identities]] keypair_env in config.toml
# POSTGRES_URL=postgres://user:pass@host:5432/db    # already set by compose
# REDIS_URL=redis://host:6379                       # already set by compose
# RECOVERY_STARTUP_RECONCILE_SECS=30                # startup gate window before modules spawn
# RECOVERY_STARTUP_BATCH=64                         # claims per worker pass during the gate
# RECOVERY_BLOCK_MODULES_ON_UNRESOLVED=true         # safe-state modules with unresolved claims
# RECOVERY_POSITION_RECHECK_SECS=300                # periodic on-chain re-verification of open positions
# RECOVERY_INTENT_JOURNAL=true                      # write-ahead intent before every Solana broadcast
# HA_REPLICA_ID=                                    # explicit replica id (empty = generated host-pid-rand)
# HA_CLAIM_LEASE_SECS=45                            # execution-claim lease (renewed every lease/3)
# HA_CLAIM_HANDOFF_GRACE_SECS=900                   # ambiguous-outcome re-acquisition block
# HA_FLAG_SYNC_SECS=5                               # kill-switch/module-flag propagation interval
# HA_BOOK_SYNC_SECS=30                              # cross-replica position-book refresh
#
# Module 3 (Polymarket) — only needed for simulate/live; paper never signs:
# POLYMARKET_PRIVATE_KEY=                           # Polygon EOA hex key for CLOB EIP-712 signing
#                                                   # (POLYGON_PRIVATE_KEY is accepted as a fallback name)
# POLY_API_KEY= / POLY_API_SECRET= / POLY_API_PASSPHRASE=
#                                                   # optional pre-derived CLOB L2 credentials; when unset
#                                                   # they are derived from the private key at start-up
#                                                   # (docs/POLYMARKET-OPERATIONS.md §1)
#
# API auth keys are configured in config.toml ([api].keys / legacy_key);
# store them as sha256 hex digests — see docs/SECURITY.md.
