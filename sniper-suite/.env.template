# =============================================================================
# sniper-suite — environment template (copy to `.env` and fill in)
# NEVER commit a real `.env` (it is gitignored). Everything here feeds
# docker-compose.yml; the bot itself reads config.toml plus the secret env
# vars listed below. Placeholders only — no real secrets in this file.
#
# Reconciled with:
#   crates/core/src/config.rs        (apply_env_overrides + seed_secret_env)
#   crates/server/src/main.rs         (seed_secret_env, startup gates)
#   docker-compose.yml                (POSTGRES_*, RUST_LOG, API_BIND_*, etc.)
#   Dockerfile                        (base image + build args; no secret env)
#   docs/ENVIRONMENT-VARIABLE-REGISTER.md (degraded/required behaviors)
#
# How to use:
#   cp .env.template .env && $EDITOR .env
#   docker compose up --build
#   # or without compose:  CONFIG_PATH=./config.toml cargo run --release --bin sniper-suite
#
# Conventions:
#   - `[BUYER SECRET]` = buyer must supply before live/billing/custody use; placeholder is empty.
#   - `[PAPER SAFE]`   = unset/false keeps paper/dry-run safe (live trading OFF).
#   - All URLs/tokens that embed secrets are read from the named env var only;
#     the config file never contains them.
#   - Do not paste real keys into this committed template; use a secrets manager
#     or shell export for production, or mount via docker-compose `environment:`.
# =============================================================================

# ---- PostgreSQL (compose + direct URL) --------------------------------------
# Compose builds POSTGRES_URL from these three; direct-connect deployments
# may set POSTGRES_URL/DATABASE_URL instead (see DatabaseConfig::url_env).
POSTGRES_USER=sniper
POSTGRES_PASSWORD=change-me-strong-password          # [BUYER SECRET] — replace in .env, never commit
POSTGRES_DB=sniper

# Direct connection URLs — [BUYER SECRET] if you use them outside compose.
# Compose already sets POSTGRES_URL=postgres://...@postgres:5432/... inside the bot container.
# DATABASE_URL is the legacy alias read by some tooling; either works if database.url_env points to it.
POSTGRES_URL=                                         # [BUYER SECRET] postgres://user:pass@host:5432/db  (leave empty when using compose)
DATABASE_URL=                                         # [BUYER SECRET] alias for POSTGRES_URL (when database.url_env=DATABASE_URL)
REDIS_URL=redis://redis:6379                          # [BUYER SECRET if non-local] redis://host:6379 or rediss://...

# ---- Bot runtime / observability --------------------------------------------
RUST_LOG=info                                         # trace|debug|info|warn|error (overrides [observability].log_level)
LOG_LEVEL=info                                        # fallback when RUST_LOG is unset (maps to config [observability].log_level)
LOG_FORMAT=json                                       # json|text
CONFIG_PATH=/app/config.toml                         # path read by crates/server/src/main.rs (compose mounts ./config.toml there)
DATA_DIR=./data                                       # [STORAGE].data_dir fallback (config.toml is authoritative)
API_BIND_HOST=127.0.0.1                               # keep 127.0.0.1 unless a TLS reverse proxy sits in front
API_PORT=8080
API_BIND_PORT=8080                                    # alias for API_BIND_HOST:PORT (config.rs env override)
# Host path of the Solana keypair JSON, mounted read-only into the container at /run/secrets/solana_keypair.json
SOLANA_KEYPAIR_HOST_PATH=./keys/solana.json
SOLANA_KEYPAIR=/run/secrets/solana_keypair.json       # [BUYER SECRET] inside-container path or JSON content mount (compose sets this)
KEYPAIR_PATH=                                         # alias/fallback path read by some modules
WALLET_PATH=                                          # alias for wallet path (same material, legacy name)
HOSTNAME=                                             # auto-set by Docker; used as HA_REPLICA_ID fallback
SAMPLE_INTERVAL_MS=5000                               # metrics sampling interval
METRICS_ENABLED=true

# ---- Network / Solana RPC / WebSocket / Geyser -------------------------------
SOLANA_CLUSTER=devnet                                 # devnet|mainnet-beta|custom (when set to devnet, defaults flip to devnet URLs)
SOLANA_RPC_URL=https://api.devnet.solana.com          # [PAPER SAFE] devnet placeholder; buyer supplies mainnet RPC for live
SOLANA_WS_URL=wss://api.devnet.solana.com
GEYSER_WS_URL=                                        # optional Geyser gRPC/WS feed (wss://...); leave empty if unused
COMMITMENT=confirmed                                  # processed|confirmed|finalized
ACCOUNT_CACHE_TTL_MS=30000
ACCOUNT_CACHE_MAX_ENTRIES=10000
RPC_RETRY_BASE_BACKOFF_MS=200
RPC_RETRY_MAX_BACKOFF_MS=5000
RPC_RETRY_JITTER=true                                 # true|false
RPC_RATE_LIMIT_COOLDOWN_MS=60000
RPC_PROVIDER_FAILURE_THRESHOLD=5
RPC_PROVIDER_COOLDOWN_MS=30000
WS_STALE_AFTER_MS=15000
MAX_BLOCKHASH_AGE_MS=60000

