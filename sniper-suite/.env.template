# ---- Custody / signing (Vault / KMS / HSM) ----------------------------------
# Only `local` is implemented in this build; selecting vault|kms|hsm without
# the referenced service FAILS STARTUP with UnsupportedBackend — no silent fallback to local.
SIGNING_PROVIDER=local                                  # local|vault|kms|hsm
VAULT_ADDR=                                             # [BUYER SECRET when vault] e.g. https://vault.example.com:8200
VAULT_TOKEN=                                            # [BUYER SECRET when vault] Vault token (env var name or value; never commit real)
KMS_KEY_ID=                                             # [BUYER SECRET when kms] ARN or env var name (e.g. arn:aws:kms:...)
HSM_SLOT=                                               # [BUYER SECRET when hsm] HSM slot/partition reference

# --- Per-identity keypair routing (signing.identities[].keypair_env) ----------
# Treasury / per-identity keypairs are referenced by env var name in config.toml:
#   [[signing.identities]] keypair_env="TREASURY_KEYPAIR"
TREASURY_KEYPAIR=                                       # [BUYER SECRET] per-identity keypair JSON/base58 for signing provider routing

# ---- Billing / commercial (Stripe / Paddle) ----------------------------------
# The billing domain is provider-neutral; these env vars only matter when you
# select stripe|paddle in [billing] or via plan checkout. With manual (default)
# no provider credentials are required. Stripe/Paddle without credentials
# returns typed Configuration error — never silent fallback to manual.
STRIPE_API_KEY=                                         # [BUYER SECRET] sk_live_... or sk_test_... (env var NAME holding the key)
PADDLE_API_KEY=                                         # [BUYER SECRET] paddle live/test key
STRIPE_WEBHOOK_SECRET=                                  # [BUYER SECRET] whsec_... for stripe webhook HMAC verification
PADDLE_WEBHOOK_SECRET=                                  # [BUYER SECRET] paddle webhook secret
# Webhook verification secrets for provider-neutral boundary (server-side HMAC):
SAAS_WEBHOOK_SECRET_MANUAL=                             # [BUYER SECRET] HMAC secret for manual provider webhooks
SAAS_WEBHOOK_SECRET_STRIPE=                             # [BUYER SECRET] HMAC secret for stripe provider webhooks (x-provider-timestamp/signature)
SAAS_WEBHOOK_SECRET_PADDLE=                             # [BUYER SECRET] HMAC secret for paddle provider webhooks
LIVE_BILLING=0                                          # [PAPER SAFE] set 1 to allow real Stripe/Paddle checkout/webhook execution (requires real keys + reachable provider)

# ---- Live / deployment safety gates -----------------------------------------
LIVE_CUSTODY=0                                          # [PAPER SAFE] set 1 to allow real Vault/KMS/HSM signing (requires reachable service, no fallback)
SOLANA_LIVE=0                                           # [PAPER SAFE] set 1 to allow mainnet Solana broadcasts with real funds (requires funded keypair + ALLOW_LIVE_TRADING=true)
DEPLOYMENT_SMOKE_LIVE=0                                 # [PAPER SAFE] set 1 to allow deployment smoke tests against live endpoints
STAKING_E2E=0                                           # set 1 to run programs/staking-suite validator e2e (needs validator)
E2E_URL=                                                # e2e harness URL override (optional)
E2E_FALLBACK_URL=                                       # e2e fallback URL (optional)

# ---- Legacy / compatibility --------------------------------------------------
LEGACY_WS_MODE=false                                     # true enables legacy WebSocket compatibility shim (if supported by build)

# ---- API keys (control-plane mutating routes) -------------------------------
# API auth is configured in config.toml [[auth.keys]] (hashes) or [api].api_key_env;
# these env vars hold the plaintext keys that the server hashes at startup.
API_KEY=                                                # [BUYER SECRET] legacy single-key plaintext (sha256 hashed at startup, never logged)
# Example for multi-key setup (add under [[auth.keys]] in config.toml, reference env var names there):
#   AUTH_KEY_OWNER=change-me-owner-key-32chars-min
#   AUTH_KEY_OPERATOR=change-me-operator-key-32chars-min

# ---- Notes ------------------------------------------------------------------
# * Postgres is the authoritative durable store; Redis is ONLY cache/dedup (losing it never loses money truth).
# * No DB + no Redis = MemoryClaimStore (single replica, paper only) + loud warn about multi-replica risk.
# * Live on Memory store warns WILL double-execute if multi-replica; combine DATABASE_ENABLED=true with POSTGRES_URL.
# * Set DATABASE_REQUIRED=true / REDIS_REQUIRED=true to fail startup when the backing service is unreachable.
# * All `*_ENABLED=false` / `ALLOW_LIVE_TRADING=false` / `LIVE_*=0` defaults keep a fresh clone in paper/dry-run safe state.
