ALLOW_LIVE_TRADING=false                              # [PAPER SAFE] set true ONLY with funded keys + explicit buyer opt-in
USE_JITO=false
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=1000
PRIORITY_FEE_MICRO_LAMPORTS=1000
COMPUTE_UNIT_LIMIT=200000
SIMULATE_FIRST=true
ABORT_ON_SIMULATION_FAILURE=false
BROADCAST_FANOUT=false
FEE_MODE=auto                                         # auto|fixed|dynamic
FEE_MIN_MICRO_LAMPORTS=1000
FEE_MAX_MICRO_LAMPORTS=100000
FEE_EMERGENCY_MAX_MICRO_LAMPORTS=1000000
FEE_PERCENTILE=50
FEE_ESCALATION_PCT=10
FEE_TREASURY=                                         # pubkey for treasury fee routing (optional)
MAX_BLOCKHASH_AGE_MS=60000

# ---- Persistence / dedup / rate-limit ---------------------------------------
DATABASE_ENABLED=false                                # true enables Postgres durable state (recommended for multi-replica)
DATABASE_REQUIRED=false                               # true => fail startup when Postgres unreachable
DATABASE_AUTO_MIGRATE=true
DATABASE_MAX_CONNECTIONS=10
REDIS_ENABLED=false
REDIS_REQUIRED=false
DEDUP_BACKEND=memory                                  # memory|redis|postgres
DEDUP_TTL_SECS=86400
RATE_LIMIT_RPM=60

