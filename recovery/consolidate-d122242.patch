+/// Deterministic UUID for a readable test label (the custody ids are UUIDs;
+/// DefaultHasher::new() is keyed the same way in every run of this binary).
+fn stable_id(label: &str) -> uuid::Uuid {
+    use std::hash::{Hash, Hasher};
+    let mut bytes = [0u8; 16];
+    for (half, chunk) in bytes.chunks_mut(8).enumerate() {
+        let mut hasher = std::collections::hash_map::DefaultHasher::new();
+        half.hash(&mut hasher);
+        label.hash(&mut hasher);
+        chunk.copy_from_slice(&hasher.finish().to_le_bytes());
+    }
+    uuid::Uuid::from_bytes(bytes)
+}
