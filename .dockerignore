# Build artifacts and local state — never ship these into the image context.
target
**/target
data
*.jsonl

# Git / VCS
.git
.gitignore

# Local secrets and overrides (bake config via a mounted file or env, not the image)
config.toml
.env
*.pem
id.json
*-keypair.json

# Editor / OS noise
.vscode
.idea
*.swp
.DS_Store

# Docs that don't affect the build
README.md
docs

# Toolchain shims, sandbox/Solana CLI state and agent-only trees never enter
# the build context (also asserted by scripts/verify-delivery.sh).
.cargo/bin
.cargo/env
.config/
uploads/
docs/archive/
evidence/
legal/
target/
apps/control-plane/node_modules
apps/control-plane/.next
apps/control-plane/test-results
*.md
!README.md

# Local run scaffolding and captured console output (Batch 01 E): the same
# host-state exclusions .gitignore carries, mirrored here so a dirty checkout
# can never bake a launcher transcript or the rustup downloader into an image
# layer. Patterns match at the context root only (`*` never spans `/`), so
# scripts/run-external-validation.sh and friends remain part of the context.
rustup-init.sh
*.out
run-*.sh
run_baseline*.sh
core-launch.out
run-tests.out
