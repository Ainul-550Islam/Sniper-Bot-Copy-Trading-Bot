{
  "name": "control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "Sniper Suite SaaS control plane: the multi-tenant web UI over the TASK 7A SaaS API. The browser owns NO secrets beyond the in-memory session token, and is never an authorization boundary.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node scripts/run-node-tests.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "audit:production": "npm audit --omit=dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
