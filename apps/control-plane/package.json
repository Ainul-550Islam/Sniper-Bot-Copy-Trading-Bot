{
  "name": "control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "Sniper Suite SaaS control plane: the multi-tenant web UI over the TASK 7A SaaS API. The browser owns NO secrets beyond the in-memory session token, and is never an authorization boundary.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "audit:production": "npm audit --omit=dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "20.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.30.1",
    "eslint-config-next": "16.3.8",
    "typescript": "5.8.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
