# Build artifacts
/target
**/target
**/*.rs.bk
*.pdb
.cargo/bin/

# Secrets — NEVER commit
.env
.env.*
!.env.template
# Anchored: the rule protects a root-level secrets directory. Unanchored,
# `keys/` also swallowed apps/control-plane/src/app/operator/keys/, which is
# the operator API-key management PAGE, not a key store.
/keys/
*.keypair.json
# `cargo build-sbf` / `solana-keygen` output: target/deploy/<name>-keypair.json
*-keypair.json
id.json
solana.json
*.pem
# The live config may carry an inline [secrets] table; only the annotated
# example is source. (Anchored: programs/staking-suite/.cargo/config.toml is
# Cargo's own config and stays tracked.)
/config.toml
!config.toml.example

# Runtime data (journal, ledgers, logs)
/data
**/data/
*.jsonl
*.log
test-validator-ledger*/

# Docker / compose local overrides
docker-compose.override.yml

# Deployment environment files (P0 §6). The TEMPLATES are source; the
# filled-in copies hold real credentials and must never be committed.
# `.env.*` above does not match these (they are `staging.env`, not
# `.env.staging`), so they need their own rule.
deploy/environments/*.env
!deploy/environments/*.env.template

# Generated TLS material and the deployment ledger (P0 §5/§7). `*.pem`
# and `*.jsonl` above already cover these; listed explicitly so the
# intent survives a future edit of those broad rules.
deploy/nginx/dhparam.pem
deploy/release/deployments.jsonl

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.orig
*.rej

# Added by the source-distribution packager (2026-09-27) so local runs never
# commit generated output. The verified tree is unchanged otherwise.
node_modules/
.next/
*.tsbuildinfo
/buyer-release/

# Local/compose backup artifacts. Dumps are customer data and a ledger is
# host state; neither belongs in version control, and a committed dump is
# a database leak that survives every later permission fix.
deploy/backups/
*.dump
*.dump.age

# Rustup shell shim and Solana CLI install state: never tracked.
.cargo/env
.config/solana/install/

# Sandbox/agent state and local tooling output: never shipped.
.config/
uploads/
.cargo/env
rustup-init.sh
apps/control-plane/test-results/
apps/control-plane/playwright-report/
*.log
bots/**/.env
bots/**/__pycache__/
bots/**/*.sqlite

# Local run scaffolding and captured console output (PART 03 K3): one-shot
# launchers and their transcripts are host state, not source. Anchored to the
# root so scripts/run-*.sh — which ARE source — stay tracked.
/run-*.sh
/run_baseline*.sh
/core-launch.out
/run-tests.out
*.out
