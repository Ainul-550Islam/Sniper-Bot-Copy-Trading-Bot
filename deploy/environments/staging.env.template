# =============================================================================
# deploy/environments/staging.env.template — STAGING environment (P0 §6).
#
# Copy to `deploy/environments/staging.env` (gitignored) and fill in.
# This file is a DELTA over `.env.template`: it sets only the variables
# whose value must differ between staging and production, plus every
# safety gate that defines what "staging" means.
#
#   set -a; . .env.template; . deploy/environments/staging.env; set +a
#
# THE RULE THIS FILE ENFORCES
# ---------------------------
# Staging exists to be broken. It therefore must be unable to:
#   * touch production's database, Redis, or object storage,
#   * sign with production's custody keys,
#   * move real funds on mainnet,
#   * charge a real card,
#   * accept a production API key.
#
# `scripts/verify-environment-separation.sh` asserts each of those
# mechanically and fails the deploy if any of them is violated. Read that
# script before changing anything here.
# =============================================================================

SNIPER_ENVIRONMENT=staging

# ---- Identity / public surface ----------------------------------------------
SNIPER_PUBLIC_HOST=staging.example.com                 # MUST differ from production
SNIPER_ACME_EMAIL=ops@example.com
SNIPER_METRICS_ALLOW_CIDR=10.0.0.0/8

# ---- Datastores — SEPARATE INSTANCES, not separate schemas ------------------
# A shared server with two databases is NOT separation: one `DROP
# DATABASE` typo, one runaway migration, one credential leak, and
# production is gone. Use distinct hosts (or at minimum distinct managed
# instances with distinct credentials).
POSTGRES_USER=sniper_staging
POSTGRES_DB=sniper_staging
POSTGRES_PASSWORD=                                      # [SECRET] distinct from production
POSTGRES_URL=                                           # [SECRET] postgres://…@postgres-staging…/sniper_staging
REDIS_URL=redis://redis-staging:6379
WEBHOOK_SECRET_ENCRYPTION_KEY=                         # [SECRET] base64-encoded 32-byte AES-256-GCM key, distinct from production
MFA_ENCRYPTION_KEY=                                     # [SECRET] stable base64-encoded 32-byte AES-256-GCM key for tenant TOTP secrets

DATABASE_ENABLED=true
DATABASE_REQUIRED=true                                  # staging must surface DB outages, not hide them
DATABASE_AUTO_MIGRATE=true                              # staging is where migrations are proven
DATABASE_MAX_CONNECTIONS=10

# ---- Safety gates — ALL OFF. Non-negotiable. --------------------------------
# Each of these is independently asserted by the separation gate. Turning
# any of them on in staging makes staging a second production.
EXECUTION_MODE=paper
ALLOW_LIVE_TRADING=false
SOLANA_LIVE=0
LIVE_BILLING=0
LIVE_CUSTODY=0
DEPLOYMENT_SMOKE_LIVE=0
KILL_SWITCH=false

# ---- Chain / network: testnets only -----------------------------------------
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# ---- Custody: staging keys, local provider ----------------------------------
# Staging NEVER references the production KMS key id / Vault path. A
# staging bug that signs with a production key is indistinguishable from
# a compromise.
SIGNING_PROVIDER=local
SOLANA_KEYPAIR_HOST_PATH=./keys/staging-solana.json
KMS_KEY_ID=
VAULT_ADDR=
VAULT_TOKEN=

# ---- Billing: test credentials only -----------------------------------------
# A `sk_live_…` key here is a release blocker, not a warning.
STRIPE_API_KEY=                                         # [SECRET] sk_test_… ONLY
STRIPE_WEBHOOK_SECRET=                                  # [SECRET] test-mode whsec_…
PADDLE_API_KEY=                                         # [SECRET] sandbox key ONLY
SAAS_WEBHOOK_SECRET_MANUAL=                             # [SECRET] distinct from production
SAAS_WEBHOOK_SECRET_STRIPE=                             # [SECRET] distinct from production
SAAS_WEBHOOK_SECRET_PADDLE=                             # [SECRET] distinct from production

# ---- API credentials — distinct from production ------------------------------
API_KEY=                                                # [SECRET] staging-only key
AUTH_KEY_OWNER=                                         # [SECRET] staging-only
AUTH_KEY_OPERATOR=                                      # [SECRET] staging-only

# ---- Observability -----------------------------------------------------------
RUST_LOG=debug                                          # verbose: staging is for diagnosis
LOG_FORMAT=json
METRICS_ENABLED=true

# ---- Modules: enabled so the surface is actually exercised -------------------
SNIPER_ENABLED=true
COPY_ENABLED=true
POLYMARKET_ENABLED=false                                # needs a funded Polygon EOA; off by default
TELEGRAM_ENABLED=false

# ---- Risk: small, so a staging bug stays cheap even on devnet ---------------
MAX_POSITION_QUOTE=1.0
DAILY_LOSS_LIMIT_QUOTE=5.0
MAX_OPEN_POSITIONS=3

# ---- Backups ------------------------------------------------------------------
# Shorter retention in staging: the data is disposable and the point of
# running the job here at all is to prove the SCHEDULE works before
# production depends on it.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_LEDGER_PATH=/app/data/backups/backups.jsonl
BACKUP_AGE_RECIPIENT=

# Restore drills run more often in staging than the production SLO
# demands: staging is where a broken drill should be discovered.
#   ./scripts/verify-backup-restore.sh --check
BACKUP_DRILL_MAX_AGE_DAYS=30

# ---- Off-site backup copy ----------------------------------------------------
# Staging may point at a cheap bucket — the goal is to prove the SYNC
# works before production depends on it.
BACKUP_OFFSITE_TARGET=
BACKUP_OFFSITE_MAX_FILES=0
# Also mirror the PITR artefacts (base backups + WAL archive) off-site.
# Leaving this false while WAL archiving runs means the fast recovery
# path dies with the host; the status endpoint reports exactly that.
BACKUP_OFFSITE_INCLUDE_PITR=true

# ---- Point-in-time recovery --------------------------------------------------
BACKUP_WAL_ARCHIVE_DIR=/wal-archive
BACKUP_WAL_HEARTBEAT_SECS=300
# A shorter base interval means less WAL to replay during a real
# recovery, at the cost of more disk. Production pays that cost.
BACKUP_BASE_INTERVAL_HOURS=24
BACKUP_BASE_RETAIN=1
BACKUP_PITR_PORT=55432
