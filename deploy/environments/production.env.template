# =============================================================================
# deploy/environments/production.env.template — PRODUCTION (P0 §6).
#
# Copy to `deploy/environments/production.env` (gitignored) and fill in.
# A DELTA over `.env.template`, exactly like the staging file, so the two
# can be diffed line-for-line to see what actually differs between the
# environments. That diff is the artifact an auditor asks for.
#
#   set -a; . .env.template; . deploy/environments/production.env; set +a
#
# NOTHING IS ENABLED BY DEFAULT HERE
# ----------------------------------
# Every live gate below ships OFF. Production is promoted to "live" by a
# deliberate, recorded change to this file — never by a default. A fresh
# copy of this template deploys a production-shaped system that cannot
# move money, which is the only safe starting state.
# =============================================================================

SNIPER_ENVIRONMENT=production

# ---- Identity / public surface ----------------------------------------------
SNIPER_PUBLIC_HOST=app.example.com                      # MUST differ from staging
SNIPER_ACME_EMAIL=ops@example.com
SNIPER_METRICS_ALLOW_CIDR=10.0.0.0/8                    # monitoring network ONLY

# ---- Datastores — dedicated instances ---------------------------------------
POSTGRES_USER=sniper_prod
POSTGRES_DB=sniper_prod
POSTGRES_PASSWORD=                                      # [SECRET] distinct from staging
POSTGRES_URL=                                           # [SECRET] postgres://…@postgres-prod…/sniper_prod
REDIS_URL=redis://redis-prod:6379
WEBHOOK_SECRET_ENCRYPTION_KEY=                         # [SECRET] base64-encoded 32-byte AES-256-GCM key, distinct per environment
MFA_ENCRYPTION_KEY=                                     # [SECRET] stable base64-encoded 32-byte AES-256-GCM key for tenant TOTP secrets

DATABASE_ENABLED=true
DATABASE_REQUIRED=true                                  # production must NEVER run on the memory store
# Migrations are applied by a GATED deploy step, not by the application
# at boot: an auto-migrating replica racing four other replicas during a
# rolling restart is how a production schema gets corrupted.
#   ./scripts/deploy-release.sh  →  runs migrations once, then rolls pods
DATABASE_AUTO_MIGRATE=false
DATABASE_MAX_CONNECTIONS=25
REDIS_ENABLED=true
REDIS_REQUIRED=false                                    # Redis is cache/dedup only; its loss must not stop trading

# ---- Live gates — OFF until deliberately promoted ---------------------------
EXECUTION_MODE=dry_run
ALLOW_LIVE_TRADING=false                                # flip ONLY with funded keys + signed change record
SOLANA_LIVE=0
LIVE_BILLING=0
LIVE_CUSTODY=0
DEPLOYMENT_SMOKE_LIVE=0
KILL_SWITCH=false

# ---- Chain / network --------------------------------------------------------
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=                                         # [SECRET] a paid, rate-limit-appropriate mainnet RPC
SOLANA_WS_URL=                                          # [SECRET]
GEYSER_WS_URL=                                          # optional

# ---- Custody ----------------------------------------------------------------
# `local` keeps a private key on the host filesystem. That is acceptable
# for staging and NOT acceptable for a production deployment holding
# customer funds: select vault|kms|hsm and set LIVE_CUSTODY=1. The server
# fails startup on an unreachable provider rather than falling back.
SIGNING_PROVIDER=local
SOLANA_KEYPAIR_HOST_PATH=./keys/production-solana.json
KMS_KEY_ID=                                             # [SECRET] production key — never referenced from staging
VAULT_ADDR=
VAULT_TOKEN=                                            # [SECRET]

# ---- Billing ----------------------------------------------------------------
STRIPE_API_KEY=                                         # [SECRET] sk_live_…
STRIPE_WEBHOOK_SECRET=                                  # [SECRET] whsec_…
PADDLE_API_KEY=                                         # [SECRET]
SAAS_WEBHOOK_SECRET_MANUAL=                             # [SECRET] distinct from staging
SAAS_WEBHOOK_SECRET_STRIPE=                             # [SECRET] distinct from staging
SAAS_WEBHOOK_SECRET_PADDLE=                             # [SECRET] distinct from staging

# ---- API credentials — distinct from staging ---------------------------------
API_KEY=                                                # [SECRET]
AUTH_KEY_OWNER=                                         # [SECRET]
AUTH_KEY_OPERATOR=                                      # [SECRET]

# ---- Observability -----------------------------------------------------------
RUST_LOG=info                                           # debug in production leaks volume and detail
LOG_FORMAT=json
METRICS_ENABLED=true

# ---- HA / multi-replica -------------------------------------------------------
# Safe ONLY once migration 0036 is applied: before it, the tenant
# kill-switch, custody rotation state and WebSocket replay set were all
# process-local, so a second replica silently ignored tenant pauses and
# admitted replayed tickets. See docs/DEPLOYMENT.md §multi-replica.
HA_REPLICA_ID=
HA_CLAIM_LEASE_SECS=45

# ---- Modules — enable per the signed go-live plan ----------------------------
SNIPER_ENABLED=false
COPY_ENABLED=false
POLYMARKET_ENABLED=false
TELEGRAM_ENABLED=false

# ---- Risk — set from the signed risk mandate, not from defaults --------------
MAX_POSITION_QUOTE=10.0
DAILY_LOSS_LIMIT_QUOTE=100.0
MAX_OPEN_POSITIONS=10

# ---- Backups (SLO D1/D2) ------------------------------------------------------
# BACKUP_AGE_RECIPIENT is intentionally left EMPTY here rather than filled
# with a placeholder: a wrong recipient produces dumps nobody can decrypt,
# which is indistinguishable from having no backups until the day you need
# one. Set it to your real age public key, and keep the private key on the
# restore host (BACKUP_AGE_IDENTITY) — not here.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_LEDGER_PATH=/app/data/backups/backups.jsonl
BACKUP_AGE_RECIPIENT=                                   # age1… public key

# Quarterly restore drill (SLO D2). Nothing automates this on purpose: it
# creates and drops a database and a human should read the result.
#   ./scripts/verify-backup-restore.sh            # run the drill
#   ./scripts/verify-backup-restore.sh --check    # is one overdue?
BACKUP_DRILL_MAX_AGE_DAYS=90

# ---- Off-site backup copy ----------------------------------------------------
# Credentials come from the host environment (AWS_* / rclone config),
# never from this file: a template in version control is the last place
# an object-store key should live.
BACKUP_OFFSITE_TARGET=
BACKUP_OFFSITE_MAX_FILES=0
# Also mirror the PITR artefacts (base backups + WAL archive) off-site.
# Leaving this false while WAL archiving runs means the fast recovery
# path dies with the host; the status endpoint reports exactly that.
BACKUP_OFFSITE_INCLUDE_PITR=true

# ---- Point-in-time recovery --------------------------------------------------
BACKUP_WAL_ARCHIVE_DIR=/wal-archive
BACKUP_WAL_HEARTBEAT_SECS=300
# A shorter base interval means less WAL to replay during a real
# recovery, at the cost of more disk. Production pays that cost.
BACKUP_BASE_INTERVAL_HOURS=12
BACKUP_BASE_RETAIN=2
BACKUP_PITR_PORT=55432
